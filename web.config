<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <!--
      IIS does not read Apache's .htaccess file. Execute the existing PHP
      error pages internally so the requested URL stays in the address bar.
      "Auto" preserves responses that PHP/FastCGI marks for pass-through,
      including the JSON 403/404 bodies returned by API endpoints.
    -->
    <httpErrors errorMode="Custom" existingResponse="Auto">
      <remove statusCode="403" subStatusCode="-1" />
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="403" subStatusCode="-1"
             path="/QRS_new/pages/403.php" responseMode="ExecuteURL" />
      <error statusCode="404" subStatusCode="-1"
             path="/QRS_new/pages/404.php" responseMode="ExecuteURL" />
    </httpErrors>
  </system.webServer>
</configuration>
